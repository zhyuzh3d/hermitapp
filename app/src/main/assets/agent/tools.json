  {
    "name": "hermit_apply_dev_files",
    "description": "Atomically create, overwrite, delete, move or rename text files in the dev tree using revision CAS.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "appId": {
          "type": "string",
