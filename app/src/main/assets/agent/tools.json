                "type": "string",
                "minLength": 1,
                "maxLength": 512,
                "description": "Relative move source"
              },
              "to": {
                "type": "string",
                "minLength": 1,
                "maxLength": 512,
                "description": "Relative move target"
              },
              "move": {
                "type": "boolean"
              }
            },
            "required": [],
            "additionalProperties": false
          }
        },
        "refreshMode": {
          "type": "string",
          "minLength": 1,
          "maxLength": 16,
          "description": "auto, reload or none"
        },
        "route": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048,
          "description": "Optional same-origin relative route"
        }
