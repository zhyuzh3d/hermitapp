  {
    "name": "hermit_reload_app",
    "description": "Reload the visible happ in its existing WebView by default, optionally recreate the runtime, restore app state, and run a bounded post-refresh script only for a development copy.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "appId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "description": "Hermit instance appId"
        },
        "strategy": {
          "type": "string",
          "enum": [
            "reload",
            "recreate"
          ],
          "description": "reload reuses the current WebView and bypasses cache; recreate rebuilds the WebView runtime."
        },
        "restoreStateJson": {
          "type": "string",
          "maxLength": 524288,
          "description": "JSON passed to window.hermitDevState.restore(state), or to the hermitdevrestore event when the hook is absent."
        },
        "postReloadScript": {
          "type": "string",
          "maxLength": 65536,
          "description": "JavaScript evaluated after refresh. Accepted only while this ordinary happ is running its development copy."
        }
      },
      "required": [
        "appId"
      ],
      "additionalProperties": false
    },
    "annotations": {
      "readOnlyHint": false,
      "destructiveHint": false,
      "idempotentHint": false,
      "openWorldHint": false
    }
  },
  {
