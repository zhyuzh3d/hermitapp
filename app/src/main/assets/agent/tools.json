                "type": "string",
                "minLength": 1,
                "maxLength": 512,
                "description": "Relative move source"
              },
              "to": {
                "type": "string",
                "minLength": 1,
                "maxLength": 512,
                "description": "Relative move target"
              },
              "move": {
                "type": "boolean"
