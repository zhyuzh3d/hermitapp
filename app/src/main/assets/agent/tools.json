          "type": "array",
          "minItems": 1,
          "maxItems": 256,
          "items": {
            "type": "object",
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1,
                "maxLength": 512,
                "description": "Relative target path"
              },
              "content": {
                "type": "string",
                "minLength": 0,
                "maxLength": 524288,
                "description": "UTF-8 text content"
              },
              "delete": {
                "type": "boolean"
              },
