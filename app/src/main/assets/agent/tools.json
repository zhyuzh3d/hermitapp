    "inputSchema": {
      "type": "object",
      "properties": {
        "runtimeMode": {
          "type": "string",
          "enum": [
            "current",
            "online",
            "local"
          ],
          "description": "Keep the configured mode, or explicitly select the official online/local HermitUI runtime before reloading."
        },
        "strategy": {
          "type": "string",
          "enum": [
            "reload",
            "recreate"
          ],
          "description": "reload reuses the current WebView and bypasses cache; recreate rebuilds the WebView runtime."
        },
        "restoreStateJson": {
          "type": "string",
          "maxLength": 524288,
          "description": "JSON passed only to HermitUI fixed window.hermitDevState.restore(state) hook."
        }
      },
      "required": [],
