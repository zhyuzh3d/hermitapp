    "app": ["info", "reload", "ready", "checkUpdate"],
    "permissions": ["status", "request"],
    "data": ["get", "put", "delete", "scan", "batch"],
    "files": ["import", "writeText", "readText", "list", "export", "delete", "share"],
    "tts": ["voices", "speak", "stop", "export"],
    "speech": ["availability", "start", "stop", "cancel"],
    "location": ["getCurrent", "watch", "clearWatch"],
    "camera": ["capturePhoto"],
    "share": ["text", "file"],
    "clipboard": ["write", "read"],
    "haptics": ["vibrate", "impact"],
    "network": ["status", "request"]
